generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnlineStatus {
  AWAKE
  ASLEEP
  OFFLINE
  UNKNOWN
}

enum LockStatus {
  LOCKED
  UNLOCKED
  UNKNOWN
}

enum CommandType {
  WAKE
  UNLOCK
  ENABLE_DRIVE
  LOCK
  HONK
  FLASH
  PRECONDITION_ON
  SEND_DESTINATION
  READY_VEHICLE
}

enum CommandResult {
  SUCCESS
  FAIL
}

model Vehicle {
  id             String    @id @db.VarChar(64)
  teslaVehicleId String    @db.VarChar(64)
  vin            String    @db.VarChar(64)
  friendlyName   String?   @db.VarChar(128)
  vcpRequired    Boolean?
  lastCapabilityCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telemetry TelemetrySnapshot[]
  commands  CommandLog[]

  @@index([teslaVehicleId])
  @@index([vin])
}

model TelemetrySnapshot {
  id             String       @id @default(cuid())
  vehicleId       String
  batteryPercent  Int?
  onlineStatus    OnlineStatus @default(UNKNOWN)
  lockStatus      LockStatus   @default(UNKNOWN)
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime     @default(now())
  source          String       @default("tesla")
  createdAt       DateTime     @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, lastSeenAt(sort: Desc)])
}

model CommandLog {
  id           String       @id @default(cuid())
  requestId    String       @db.VarChar(128)
  vehicleId    String
  command      CommandType
  triggeredBy  String       @db.VarChar(128)
  result       CommandResult
  errorReason  String?      @db.VarChar(64)
  errorMessage String?      @db.VarChar(512)
  teslaStatus  Int?
  createdAt    DateTime     @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, requestId, command])
  @@index([vehicleId, createdAt(sort: Desc)])
  @@index([triggeredBy, createdAt(sort: Desc)])
}

model TeslaConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String?  // space-delimited string is fine for MVP
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model TeslaAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model TeslaOAuthSession {
  id         String   @id @default(cuid())
  state      String   @unique
  verifier   String
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

// ── Temporary vehicle sharing (ride-share codes) ──────────
// Lets a Tesla-connected owner grant another logged-in Parlé user temporary,
// app-level access to a vehicle WITHOUT sharing Tesla tokens. Commands from a
// guest are executed with the owner's Tesla connection, gated by an active
// TemporaryVehicleAccess record and its permissions.

model VehicleShareCode {
  id           String   @id @default(cuid())
  ownerUserId  String
  vehicleId    String
  vin          String?
  friendlyName String?
  code         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([ownerUserId])
  @@index([vehicleId])
  @@index([code])
}

model TemporaryVehicleAccess {
  id           String    @id @default(cuid())
  ownerUserId  String
  guestUserId  String
  vehicleId    String
  vin          String?
  friendlyName String?
  // Null for renter "public claim" grants (POST /vehicles/:id/claim); set for
  // grants created by redeeming a share code. Used to decide whether ending a
  // ride should return the vehicle to public availability.
  shareCodeId  String?
  permissions  Json
  startsAt     DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([guestUserId])
  @@index([ownerUserId])
  @@index([vehicleId])
}
